captures/

# Kotlin / Java
*.class
*.jar
*.war
*.ear

# Logs & crash dumps
*.log
hs_err_pid*
replay_pid*

# Archive folder (local dev artifacts, logs, iteration history)
old/

# Generated / temp
app_icon_generated.png

# Python（tools/ 下的素材流水线脚本）
__pycache__/
*.pyc

# 兄弟项目（FocusCat 是独立仓库，拥有各自的 GitHub 远端）
# FocusCat 与 DeepFocus 是两个互不相关的 App，禁止把对方的文件混进来。
# 只锚定仓库根目录，不要用 **/ 前缀 —— 否则任何层级下名为 focuscat
# 的目录都会被误伤（包括未来本项目自己可能引入的包路径）。
/FocusCat/
/focuscat/
/DeepFocus/
/deepfocus/

# 视频压缩中间产物
*.compressed.mp4
