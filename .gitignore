# Local configuration
local.properties
gradle.properties

# 本地 AI 接入点（含 API Key，**禁止提交**）
# 开发时把厂商/端点/模型/key 写进 local.ai.properties，
# 由 tools/db/seed_ai_config.py 灌进设备。
local.ai.properties
*.ai.properties

# Signing keys — never commit
*.jks
*.keystore

