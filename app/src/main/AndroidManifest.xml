<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 使用情况访问权限（统计应用使用数据） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 开机自启动 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 电池优化白名单（避免系统杀死无障碍服务，解决退出后权限失效） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 通知权限（2026-11-18 用户要求恢复用户可见通知）
         大肥鱼主动找你说话时，除了写进聊天记录，还会弹一条通知 ——
         用户不在 App 里也能收到。运行时申请，用户拒绝也不影响其它功能。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 精确闹钟（保活守护闹钟，Android 12+ 需用户授权，可被撤销后自动降级） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 网络权限：大肥鱼 AI 对话需要访问用户自填的 LLM API（OpenAI 兼容端点） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 通用 intent 查询：桌宠拉起应用等场景需要 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".DeepFocusApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.DeepFocus"
        tools:targetApi="35">

        <!--
            WorkManager 初始化：改成手动（app 用 Configuration.Provider 提供配置）。
            不关掉默认初始化的话，WorkManager 会在 onCreate 里用默认配置初始化一次，
            再跟我们的 Configuration.Provider 冲突（"已初始化"异常）。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- 主界面 -->
        <!--
            launchMode="singleTask"（必须）：
            专注锁机把用户拉回 App 时走 startActivity + FLAG_ACTIVITY_NEW_TASK。
            默认 standard 会新建一个 MainActivity 实例 → 新 NavController →
            新 FocusViewModel → 计时从零重来，用户刚专注的时长全部作废。
            singleTask 让同一个实例复用（走 onNewIntent），计时才接得上。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DeepFocus.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 无障碍服务 - 监听应用启动 -->
        <!-- 需求 3：stopWithTask=false —— 用户从最近任务划掉应用时，
             系统默认会连带停止该任务内的服务，导致无障碍服务被关闭。
             设为 false 后，划掉应用不会停掉无障碍服务，
             它由系统按绑定关系持续托管，进程重建后自动重新绑定。 -->
        <service
            android:name=".accessibility.AppMonitorService"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:stopWithTask="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 桌宠开机自启
             Android 15 起后台不能直接起前台服务，
             所以走「透明中转 Activity」在可见状态下启动。 -->
        <receiver
            android:name=".pet.PetBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 桌宠自启中转 Activity（透明，用户看不到） -->
        <activity
            android:name=".pet.PetBootActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.DeepFocus.PetBoot" />

        <!-- 前台保活服务
             Android 14+ 要求 specialUse 类型必须声明子类型（PROPERTY_SPECIAL_USE_FGS_SUBTYPE），
             这个 property 必须写在 <service> 元素**内部** —— 写在 <application> 下系统读不到，
             startForeground() 会抛 IllegalArgumentException，服务直接起不来。 -->
        <service
            android:name=".service.DeepFocusService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="deep_focus_app_lock" />
        </service>

        <!-- 桌宠悬浮窗服务
             Android 8.0+ 后台不能显示悬浮窗，必须挂在前台服务上。
             Android 14+ 要求声明具体类型 —— 桌宠归类为 specialUse。
             Android 15 起要求起服务前已有可见叠加层，所以只能由用户主动开启时启动。 -->
        <service
            android:name=".pet.DesktopPetService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="deep_focus_desktop_pet" />
        </service>

        <!-- 保活 JobService（需求 1+4）
             JobScheduler 周期任务，进程被 ColorOS 杀掉后由系统拉起并自动重绑无障碍服务 -->
        <service
            android:name=".service.KeepAliveJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- 开机自启动 / 应用更新后自恢复接收器 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 修复 C：AlarmManager 第三方守护者接收器 -->
        <!-- 由 setInexactRepeating 定时触发，独立于 app 进程，确保前台服务被杀后能被拉起 -->
        <receiver
            android:name=".service.ServiceRestartReceiver"
            android:exported="false" />

        <!-- 文件提供者 - 用于数据导出分享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
